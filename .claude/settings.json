{
  "permissions": {
    "allow": [
      "Bash(clang-format *)",
      "Bash(uncrustify *)",
      "Bash(sed *)"
    ]
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache/ccache"
      ]
    },
    "network": {
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-build-reads.sh"
          }
        ]
      }
    ]
  }
}
