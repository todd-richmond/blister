{
  "env": {
    "CCACHE_DISABLE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(clang-format *)",
      "Bash(uncrustify *)",
      "Bash(sed *)"
    ]
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "build",
        "**/CMakeFiles",
        ".cache",
        ".lto",
        "Testing",
        "autom4te.cache",
        "bak",
        "**/*.pch"
      ]
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
