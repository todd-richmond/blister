{
  "[c][cpp][h][makefile]": {
    "editor.formatOnType": true,
    "editor.indentSize": 4,
    "editor.inlayHints.enabled": "off",
    "editor.insertSpaces": false,
    "editor.tabSize": 8
  },
  "[markdown]": {
    "editor.rulers": []
  },
  "C_Cpp.clang_format_sortIncludes": true,
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.default.compilerArgs": [
    "-Wno-deprecated-declarations"
  ],
  "c-cpp-flylint.cppcheck.extraArgs": [
    "--suppressions-list=${workspaceFolder}/.cppcheck-suppressions"
  ],
  "c-cpp-flylint.clang.extraArgs": [
    "-DBUILD_BLISTER",
    "-I${workspaceFolder}/lib",
    "-include",
    "${workspaceFolder}/lib/stdapi.h",
    "-std=gnu++23",
    "-Wno-deprecated-declarations",
    "-Wno-old-style-cast",
    "-Wno-unknown-pragmas"
  ],
  "chat.experimental.permissionsSandboxToggle.enabled": true,
  "cmake.generator": "Unix Makefiles",
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cppcheck-official.arguments": "--suppressions-list=${workspaceFolder}/.cppcheck-suppressions",
  "cpplint.cpplintPath": "cpplint",
  "cpplint.excludes": [
    "CMakeFiles"
  ],
  "cpplint.filters": [
    "-build/header_guard",
    "-build/include",
    "-build/include_order",
    "-build/include_subdir",
    "-build/include_what_you_use",
    "-build/namespaces",
    "-legal/copyrigh",
    "-readability/braces",
    "-readability/casting",
    "-readability/multiline_comment",
    "-readability/nolint",
    "-readability/todo",
    "-runtime/int",
    "-runtime/operator",
    "-runtime/printf",
    "-runtime/references",
    "-runtime/string",
    "-runtime/threadsafe_fn",
    "-whitespace/comments",
    "-whitespace/indent",
    "-whitespace/newline",
    "-whitespace/line_length",
    "-whitespace/parens",
    "-whitespace/semicolon",
    "-whitespace/tab"
  ],
  "editor.autoIndentOnPaste": true,
  "editor.detectIndentation": false,
  "editor.rulers": [80],
  "editor.wordwrap": "on",
  "editor.wrappingIndent": "indent",
  "explorer.excludeGitIgnore": true,
  "files.associations": {
    "*.inc": "makefile"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/build": true,
    "**/CMakeFiles": true,
    "**/.cache": true,
    "**/.lto": true,
    "**/Testing": true,
    "**/autom4te.cache": true,
    "**/bak": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/CMakeFiles/**": true,
    "**/.cache/**": true,
    "**/.lto/**": true,
    "**/Testing/**": true,
    "**/autom4te.cache/**": true,
    "**/bak/**": true
  },
  "files.trimTrailingWhitespace": true,
  "git.ignoreLimitWarning": true,
  "search.exclude": {
    "**/build": true,
    "**/CMakeFiles": true,
    "**/.cache": true,
    "**/.lto": true,
    "**/Testing": true,
    "**/autom4te.cache": true,
    "**/bak": true,
    "**/compile_commands.json": true
  },
  "search.useIgnoreFiles": true
}
