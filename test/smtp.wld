# smtpload [-a [numfiles]] [-b bodyfile|bodydir] [-c cachemb] [-d]
#    [-h host[:port]] [-l loops] [-m maxuser] [-p] [-q|-v]* [-r] [-s stattime]
#    [-t threads] [-w timeout] cmdfile
#
# options:
#    -a [numfiles]: send all files (or limit to numfiles) in bodydir
#    -b bodyfile/dir: RFC822 message file or directory
#    -c cachemb: MB of body files to cache in memory
#    -d: send messages with DATA even if the server supports BDAT (CHUNKING)
#    -h host[:port]: SMTP host and port - default is localhost:25
#    -l loops: total number of messages to send
#    -m maxuser: maximum user id - default is thread count
#    -p: pipeline commands - from and rcpt time is included in body or data
#    -q: quiet - don't output statistics results, just return 0 or 1 (failure)
#    -r: randomize ids when used with variable expansion
#    -s secs: print rolling statistics every n seconds
#    -t threads: number of sending threads
#    -v: verbose
#    -w: SMTP connect and reply timeout in ms
#
# commands:
#    connect [tls], ehlo|helo|lhlo [domain], starttls, auth user pass,
#        xclient args, rset, quit: connect tls is implicit TLS (SMTPS) and
#        starttls needs another ehlo
#    from|rcpt|to|cc|bcc|vrfy address [parameters]: parameters such as
#        SIZE=, BODY=, NOTIFY= and ORCPT= follow the address
#    header|hdr text, subject text: headers for body and mime
#    body [text]: message from the headers and text, else a body file
#    data: send a body file as a complete message
#    mime [text]: start a multipart message, then attach and end
#    attach [type [base64|qp]]: encode a body file as an attachment
#    end: finish a mime message
#    other: sent as is; a trailing =NNN is the expected reply code (250)

var domain=example.com
var user=user
var addr=$$(user)@$(domain)

connect
ehlo example.com
from $(addr)
rcpt $(addr)
data
quit
